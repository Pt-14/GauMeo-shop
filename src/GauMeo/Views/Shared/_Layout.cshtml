<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GauMeo Shop</title>
    <link rel="website icon" type="png" href="~/images/webicon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <!-- Common CSS Files - Loaded on all pages -->
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <!-- components.css: gộp từ components-common.css + components-404.css (Newsletter + Error page) -->
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Conditional CSS Loading -->
    @* Auth CSS - Load when user is authenticated (for logout button) or on Account pages *@
    @if (User.Identity?.IsAuthenticated == true || 
         ViewContext.RouteData.Values["controller"]?.ToString() == "Account")
    {
        <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    }
    
    @* Help Pages CSS - Load only on Footer controller pages *@
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Footer")
    {
        <link rel="stylesheet" href="~/css/components-help.css" asp-append-version="true" />
    }
    
    @* 404/Error styles đã nằm trong components.css (load global phía trên), không cần load riêng *@
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="sticky-header">
        <div class="top-bar">
            <span class="top-bar-left">Giờ hoạt động: 8 AM - 22 PM</span>
            <div class="top-bar-slider">
                <button class="slider-nav prev" onclick="changeSlide(-1)">‹</button>
                <div class="slider-content">
                    <span class="slider-item active">
                        Đơn từ 700K – Freeship nội thành TP.HCM, giao nhanh trong ngày. 
                        <a href="/Brand/Index" class="slider-link">Mua ngay!</a>
                    </span>
                    <span class="slider-item">
                        Đưa đón thú cưng tận nơi – Miễn phí dưới 5km cho mọi dịch vụ làm đẹp. 
                        <a href="/Service/Index" class="slider-link">Đặt lịch ngay!</a>
                    </span>
                    <span class="slider-item">
                        Chỉ dành cho hội viên VIP – Ưu đãi sớm hơn, nhiều hơn, xịn hơn. 
                        <a href="/VIP/Index" class="slider-link">Hãy tham gia ngay!</a>
                    </span>
                </div>
                <button class="slider-nav next" onclick="changeSlide(1)">›</button>
            </div>
            <span class="top-bar-right-info">
                <span class="top-bar-center">Email: info.gaumeo@gmail.com</span>
                <span class="top-bar-right">Hotline: 0901234567</span>
            </span>
        </div>
        <div class="main-header">
            <a class="logo" href="/Home/Index">
                <img src="/images/logo-light.png" alt="logo" class="logo-img">
            </a>
            @await Component.InvokeAsync("HeaderData")
            <div class="header-icons">
                <form class="search-form" onsubmit="return false;">
                    <div class="search-container">
                        <button type="submit" class="search-btn" title="Tìm kiếm" aria-label="Tìm kiếm">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#111" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="9" r="7"/><line x1="15" y1="15" x2="18" y2="18"/></svg>
                        </button>
                        <input id="search_topnav" type="search" name="q" value="" placeholder="Tìm kiếm" class="search-input" maxlength="128" autocomplete="off">
                        <span class="search-clear" title="Xóa">×</span>
                        <label class="search-label">Tìm kiếm</label>
                    </div>
                </form>
                <div class="user-dropdown-wrapper">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="#" class="user-icon" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (User.Identity.IsAuthenticated)
                            {
                                var avatarClaim = User.Claims.FirstOrDefault(c => c.Type == "Avatar");
                                if (avatarClaim != null)
                                {
                                    <img src="@avatarClaim.Value" alt="Avatar" class="user-avatar" />
                                }
                            }
                            else
                            {
                                <i class="fas fa-user"></i>
                            }
                        </a>
                        <div class="user-dropdown-menu">
                            <a href="/Account/Profile" class="user-dropdown-item">Trang cá nhân</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="user-dropdown-divider"></div>
                                <a href="@Url.Action("Index", "Home", new { area = "Admin" })" class="user-dropdown-item admin-link">
                                    Trang quản lý
                                </a>
                            }
                            <div class="user-dropdown-divider"></div>
                            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" style="margin: 0;">
                                <button type="submit" class="user-dropdown-item" style="width: 100%; border: none; background: none; cursor: pointer; padding: 8px 16px;">
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a href="/Account/Login" class="icon-btn user-dropdown-trigger" title="Tài khoản">
                            <div class="user-icon">
                                <svg fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="8" r="4"/><path d="M3 20c0-4 8-4 8-4s8 0 8 4"/></svg>
                            </div>
                        </a>
                        <div class="user-dropdown-menu">
                            <a href="/Account/Login" class="user-dropdown-item">Đăng nhập</a>
                            <div class="user-dropdown-divider"></div>
                            <a href="/Account/Register" class="user-dropdown-item">Đăng ký</a>
                        </div>
                    }
                </div>
                <a href="/Account/Profile#my-wishlist" class="icon-btn" title="Yêu thích">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M22.813 7.338a6.736 6.736 0 0 0-3.8-4.49c-3.206-1.471-6 .878-7.016 1.9-1.013-1.025-3.813-3.374-7.016-1.9a6.736 6.736 0 0 0-3.8 4.49 5.818 5.818 0 0 0 1 4.98c1.708 2.215 9.156 8.891 9.472 9.174a.514.514 0 0 0 .688 0c.316-.283 7.764-6.959 9.472-9.174a5.815 5.815 0 0 0 1-4.98zM21 11.689c-1.448 1.878-7.488 7.362-9 8.726-1.512-1.364-7.552-6.848-9-8.726a4.8 4.8 0 0 1-.812-4.1 5.711 5.711 0 0 1 3.226-3.8c2.229-1.027 4.731.311 6.186 2.05a.516.516 0 0 0 .4.188.516.516 0 0 0 .4-.188c.029-.035 2.958-3.536 6.188-2.055a5.714 5.714 0 0 1 3.226 3.8A4.8 4.8 0 0 1 21 11.689z"/><path d="M6.346 5a4.39 4.39 0 0 0-2.473 2.928 3.818 3.818 0 0 0 .656 3.272.515.515 0 0 0 .816-.629 2.8 2.8 0 0 1-.472-2.392 3.366 3.366 0 0 1 1.9-2.237A.515.515 0 0 0 6.346 5z"/></svg>
                </a>
                <a href="/Cart/Index" class="icon-btn" title="Giỏ hàng" style="position:relative;">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><defs><style>.cls-1{fill:#231f20}</style></defs><g id="cart"><path class="cls-1" d="M29.46 10.14A2.94 2.94 0 0 0 27.1 9H10.22L8.76 6.35A2.67 2.67 0 0 0 6.41 5H3a1 1 0 0 0 0 2h3.41a.68.68 0 0 1 .6.31l1.65 3 .86 9.32a3.84 3.84 0 0 0 4 3.38h10.37a3.92 3.92 0 0 0 3.85-2.78l2.17-7.82a2.58 2.58 0 0 0-.45-2.27zM28 11.86l-2.17 7.83A1.93 1.93 0 0 1 23.89 21H13.48a1.89 1.89 0 0 1-2-1.56L10.73 11H27.1a1 1 0 0 1 .77.35.59.59 0 0 1 .13.51z"/><circle class="cls-1" cx="14" cy="26" r="2"/><circle class="cls-1" cx="24" cy="26" r="2"/></g></svg>
                    @await Component.InvokeAsync("CartCount")
                </a>
            </div>
        </div>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    <footer>
        <!-- Newsletter Section -->
        <section class="newsletter-section">
            <div class="newsletter-container">
                <div class="newsletter-content">
                    <div class="newsletter-header">
                        <h2 class="newsletter-title">Đăng ký nhận tin từ GauMeo</h2>
                        <img alt="paper airplane" src="~/images/paper-airplane-right-2.png" class="paper-airplane">
                    </div>
                    <p class="newsletter-subtitle">
                        Tại sao không? Hãy đăng ký ngay để nhận những tin tức, ưu đãi và cập nhật mới nhất qua email.
                    </p>
                    <div class="newsletter-form-container">
                        <form id="newsletterForm" class="newsletter-form" asp-controller="Newsletter" asp-action="Subscribe" method="post">
                            @Html.AntiForgeryToken()
                            <div class="form-fieldset">
                                <div class="form-wrap">
                                    <div class="input-container">
                                        <input class="form-input input-subscribe" 
                                            aria-label="Đăng ký nhận tin tức" 
                                            id="newsletterEmail" 
                                            name="email" 
                                            type="email" 
                                            placeholder=" " 
                                            aria-required="true" 
                                            required>
                                        <span class="floating-placeholder">Nhập địa chỉ email của bạn</span>
                                    </div>
                                    <button type="submit" id="newsletterSubmit" class="btn-subscribe">Gửi</button>
                                </div>
                            </div>
                            <div id="newsletterMessage" class="newsletter-message"></div>
                        </form>
                    </div>
                </div>
                <img class="cat-image" loading="lazy" alt="cat" src="~/images/cat-bats-at-air-white-bg.png">
            </div>
        </section>

        <!-- Footer columns -->
        <div class="footer-main">
            <div class="footer-col">
                <div class="footer-title">
                    <span class="footer-icon">
                        <svg width="22" height="22" fill="none" stroke="#D6D6D6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    </span>Hỗ trợ khách hàng
                </div>
                <a href="@Url.Action("MembershipBenefits", "Footer")">Quyền lợi hội viên</a>
                <a href="@Url.Action("FAQ", "Footer")">Câu hỏi thường gặp</a>
                <a href="@Url.Action("PrivacyPolicy", "Footer")">Chính sách bảo mật</a>
                <a href="@Url.Action("ReturnPolicy", "Footer")">Chính sách đổi trả & hoàn tiền</a>
                <a href="@Url.Action("PaymentShipping", "Footer")">Phương thức thanh toán & vận chuyển</a>
            </div>
            <div class="footer-col">
                <div class="footer-title">
                    <span class="footer-icon">
                        <svg width="22" height="22" fill="none" stroke="#D6D6D6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><polyline points="3 7 12 13 21 7"/></svg>
                    </span>Liên hệ
                </div>
                <div>Email: info.gaumeopetshop@gmail.com</div>
                <div>Hotline: 09xxxxxxxx</div>
            </div>
            <div class="footer-col">
                <div class="footer-title">
                    <span class="footer-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" stroke="#D6D6D6" viewBox="0 0 47.935 48.001"><g fill="#1a171b"><path d="M43.292 0H12.47a4.647 4.647 0 0 0-4.642 4.641v3.027H.727A.727.727 0 0 0 0 8.4v31.046A8.565 8.565 0 0 0 8.555 48h30.824a8.565 8.565 0 0 0 8.556-8.555V4.641A4.648 4.648 0 0 0 43.292 0zM9.283 4.64a3.191 3.191 0 0 1 3.187-3.186h27.465a4.609 4.609 0 0 0-1.284 3.186v34.076h-6.373V8.4a.727.727 0 0 0-.728-.727H9.282V4.64zm-.728 41.905a7.109 7.109 0 0 1-7.1-7.1V9.123h29.367v30.322a8.553 8.553 0 0 0 3.788 7.1zm37.925-7.1a7.1 7.1 0 0 1-14.165.727h7.063a .729.729 0 0 0 .728-.727V4.64a3.188 3.188 0 0 1 6.375 0v34.805z"/><path d="M26.805 19.8h-7a.728.728 0 0 0 0 1.456h7a.728.728 0 1 0 0-1.456zM26.805 13.488h-7a.728.728 0 0 0 0 1.456h7a.728.728 0 1 0 0-1.456zM26.805 26.1h-7a.727.727 0 1 0 0 1.454h7a.727.727 0 1 0 0-1.454zM26.805 32.41H20.9a.728.728 0 1 0 0 1.456h5.906a.728.728 0 1 0 0-1.456zM5.472 33.865H17.02a.728.728 0 0 0 0-1.456H5.472a.728.728 0 1 0 0 1.456zM22.926 38.716H14.2a.728.728 0 0 0 0 1.456h8.726a.728.728 0 0 0 0-1.456zM10.321 38.716H5.472a.728.728 0 1 0 0 1.456h4.849a.728.728 0 1 0 0-1.456zM5.472 27.556h9.7a.728.728 0 0 0 .728-.727V14.214a.729.729 0 0 0-.728-.727h-9.7a.728.728 0 0 0-.728.727v12.615a.729.729 0 0 0 .728.727zM6.2 14.943h8.243V26.1H6.2z"/></g></svg>
                    </span>Thông tin cửa hàng
                </div>
                <div>Địa chỉ: 147 Trần Hưng Đạo, Phường Bến Thành, TP.HCM</div>
                <div>Giờ mở cửa: 8:00 - 22:00 hàng ngày</div>
            </div>
            <div class="footer-col">
                <div class="footer-title">
                    <span class="footer-icon">📱</span>Kết nối với chúng tôi
                </div>
                <div class="footer-social">
                    <ul class="wrapper">
                        <li class="icon facebook">
                            <span class="tooltip">Facebook</span>
                            <a href="https://facebook.com" target="_blank" aria-label="Facebook">
                                <span><i class="fab fa-facebook-f"></i></span>
                            </a>
                        </li>
                        <li class="icon instagram">
                            <span class="tooltip">Instagram</span>
                            <a href="https://instagram.com" target="_blank" aria-label="Instagram">
                                <span><i class="fab fa-instagram"></i></span>
                            </a>
                        </li>
                        <li class="icon twitter">
                            <span class="tooltip">Twitter</span>
                            <a href="https://x.com" target="_blank" aria-label="X">
                                <span><i class="fab fa-x-twitter"></i></span>
                            </a>
                        </li>
                        <li class="icon shopee">
                            <span class="tooltip">Shopee</span>
                            <a href="https://shopee.vn/" target="_blank" aria-label="Shopee">
                                <img src="https://img.icons8.com/?size=100&id=mBkyWceUPlkM&format=png&color=000000" alt="Shopee" style="width:20px; height:20px;">
                            </a>
                        </li>
                        <li class="icon lazada">
                            <span class="tooltip">Lazada</span>
                            <a href="https://lazada.vn/" target="_blank" aria-label="Lazada">
                                <img src="https://img.icons8.com/?size=100&id=MIG1bB2e9EAh&format=png&color=000000" alt="Lazada" style="width:20px; height:20px;">
                            </a>
                        </li>
                        <li class="icon tiktok">
                            <span class="tooltip">TikTok</span>
                            <a href="https://shop-vn.tiktok.com/" target="_blank" aria-label="TikTok">
                                <span><i class="fab fa-tiktok"></i></span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="copyright">
            © 2025 GauMeo Petshop, Inc. All rights reserved by Fang.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Common scripts - loaded on all pages -->
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/cart-helper.js" asp-append-version="true"></script>
    
    <!-- Account scripts - load always (contains logout button for authenticated users and forgot password for all) -->
    <script src="~/js/account.js" asp-append-version="true"></script>
    
    <!-- Home page scripts - only load on home page -->
    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && 
         ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        <script src="~/js/index.js"></script>
    }
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 